---
import { Search, X, ExternalLink, FileText, ArrowRight, CornerDownLeft, Sparkles, BookOpen, Download } from 'lucide-astro';
import airportsData from '../data/airports.json';

const airportSearchItems = airportsData.map((a) => ({
  id: a.id,
  type: 'airport',
  typeLabel: '机场评测',
  title: a.name,
  desc: a.tagline || a.description,
  tags: (a.tags || []).join(' ') + ' ' + (a.protocols || []).join(' ') + ' ' + (a.linesType || ''),
  price: a.priceRange || `¥${a.startingPrice}/月`,
  url: a.reviewUrl || `/airports/${a.id}`,
  affiliateUrl: a.affiliateUrl || `/go/${a.id}`,
  isRisk: a.isWarning || a.status === 'risk',
}));

const tutorialSearchItems = [
  {
    id: 'guide-shadowrocket',
    type: 'guide',
    typeLabel: '保姆级教程',
    title: 'Shadowrocket (小火箭) iOS 完整配置与 AI 使用指南',
    desc: '从获取美区 Apple ID、一键导入机场订阅、设置「配置」智能分流到 ChatGPT / Claude 解锁。',
    tags: 'shadowrocket 小火箭 ios 苹果 iphone ipad 订阅导入 chatgpt 配置',
    price: '免费教程',
    url: '/blog/shadowrocket-ios-tutorial',
    affiliateUrl: '/clients',
    isRisk: false,
  },
  {
    id: 'guide-ai-tools',
    type: 'guide',
    typeLabel: 'AI深度指南',
    title: '2026 全主流 AI 工具深度使用与防封指南 (ChatGPT / Claude / Cursor)',
    desc: '彻底解决 Access Denied 1020 报错，掌握 TUN 虚拟网卡模式、原生住宅 IP 与专线分流技巧。',
    tags: 'ai chatgpt claude cursor midjourney tun 虚拟网卡 防封号 openai',
    price: '核心推荐',
    url: '/blog/ai-tools-client-guide',
    affiliateUrl: '/clients',
    isRisk: false,
  },
  {
    id: 'guide-clash-verge',
    type: 'guide',
    typeLabel: 'Windows/Mac教程',
    title: 'Clash Verge Rev 2026 终极保姆级新手配置与规则分流教程',
    desc: '支持 Mihomo (Meta) 内核，自带中文界面，一键开启 TUN 模式接管全系统应用。',
    tags: 'clash clash verge rev windows mac tun 规则分流 客户端配置',
    price: '新手必读',
    url: '/blog/clash-verge-rev-tutorial',
    affiliateUrl: '/clients',
    isRisk: false,
  },
  {
    id: 'guide-clients-hub',
    type: 'tool',
    typeLabel: '客户端下载',
    title: '常用科学上网客户端官方下载中枢 (Windows / iOS / Mac / Android)',
    desc: '官方开源 GitHub Releases 与正规 App Store 直达，拒绝任何第三方被加料打包版。',
    tags: '客户端 下载 clash singbox shadowrocket v2rayn surge 安卓 苹果 电脑',
    price: '官方安全源',
    url: '/clients',
    affiliateUrl: '/clients',
    isRisk: false,
  },
  {
    id: 'guide-coupons',
    type: 'tool',
    typeLabel: '福利中心',
    title: '福利中心：2026 核心机场专属折扣码与限时立减优惠券',
    desc: '汇集闪电鼠 sd88、大佬云 dly88、榴莲云 ll88、神行加速 sx0077 等专属独家优惠码。',
    tags: '优惠码 折扣券 福利 闪电鼠 大佬云 榴莲云 神行加速 便宜 签到 免费',
    price: '独家特惠',
    url: '/coupons',
    affiliateUrl: '/coupons',
    isRisk: false,
  },
];

const searchData = [...airportSearchItems, ...tutorialSearchItems];
---

<!-- Search Trigger Modal Wrapper -->
<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden bg-slate-950/70 backdrop-blur-md flex items-start justify-center pt-20 px-4 transition-all"
  role="dialog"
  aria-modal="true"
  aria-label="全站机场与教程搜索"
>
  <div class="max-w-2xl w-full rounded-3xl bg-white dark:bg-surface-900 border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden flex flex-col max-h-[80vh]">
    
    <!-- Top Search Input Bar -->
    <div class="relative p-4 border-b border-slate-200 dark:border-slate-800 flex items-center gap-3">
      <Search class="w-5 h-5 text-indigo-500 shrink-0" />
      <input
        id="search-input"
        type="search"
        placeholder="搜索机场名称、协议 (VLESS/IEPL)、AI 工具 (ChatGPT/Cursor) 或客户端..."
        class="w-full bg-transparent text-sm font-medium text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none"
        autocomplete="off"
      />
      <button
        id="search-close-btn"
        type="button"
        class="p-1 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-white cursor-pointer"
        aria-label="关闭搜索框"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <!-- Search Results Container -->
    <div id="search-results" class="p-4 overflow-y-auto space-y-2 flex-grow">
      <div class="text-center py-8 text-xs text-slate-400" id="search-empty-state">
        <span>输入关键词开始搜索（支持按机场名、小火箭、Clash、AI 工具或优惠码筛选）</span>
      </div>
    </div>

    <!-- Footer Shortcuts -->
    <div class="p-3 bg-slate-50 dark:bg-surface-950 border-t border-slate-200 dark:border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1">
          <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 font-mono">ESC</kbd> 退出
        </span>
        <span class="flex items-center gap-1">
          <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 font-mono">Ctrl K</kbd> 呼出
        </span>
      </div>
      <span class="text-indigo-500 dark:text-sky-400 font-semibold">机场指南针 实时索引引擎</span>
    </div>

  </div>
</div>

<script define:vars={{ searchData }}>
  function initSearchModal() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input');
    const closeBtn = document.getElementById('search-close-btn');
    const resultsContainer = document.getElementById('search-results');
    const triggerButtons = document.querySelectorAll('.search-modal-trigger');

    function openModal() {
      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => input?.focus(), 50);
    }

    function closeModal() {
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
      if (input) input.value = '';
      renderResults('');
    }

    // Keyboard Shortcuts (Cmd+K / Ctrl+K / ESC)
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (modal?.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      }
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });

    triggerButtons.forEach((btn) => btn.addEventListener('click', openModal));
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Resolve URL for offline file:// preview vs http server
    function resolveHref(rawUrl) {
      if (!rawUrl) return '#';
      if (rawUrl.startsWith('http://') || rawUrl.startsWith('https://')) return rawUrl;
      const isFile = window.location.protocol === 'file:';
      if (!isFile) return rawUrl;

      // Determine depth from root based on current location
      const path = window.location.pathname.replace(/\\/g, '/');
      const segments = path.split('/').filter(Boolean);
      // check if we are in a subdirectory like /airports/xxx/ or /blog/xxx/
      let depth = 0;
      if (segments.length >= 2) {
        const last = segments[segments.length - 1];
        if (last.endsWith('.html')) {
          depth = segments.length - 2; // e.g. dist/airports/index.html -> depth 1
        }
      }
      const prefix = depth === 0 ? './' : '../'.repeat(depth);
      const cleanUrl = rawUrl.replace(/^\//, '');
      return prefix + cleanUrl + (cleanUrl.endsWith('.html') ? '' : '/index.html');
    }

    // Real-time Fuzzy Search
    function renderResults(query) {
      if (!resultsContainer) return;

      const q = query.trim().toLowerCase();
      if (!q) {
        resultsContainer.innerHTML = `
          <div class="text-center py-8 text-xs text-slate-400">
            <span>输入关键词开始搜索（支持按机场名、小火箭、Clash、AI 工具或优惠码筛选）</span>
          </div>
        `;
        return;
      }

      const matches = searchData.filter((item) => {
        return (
          item.title.toLowerCase().includes(q) ||
          item.desc.toLowerCase().includes(q) ||
          item.tags.toLowerCase().includes(q)
        );
      });

      if (matches.length === 0) {
        resultsContainer.innerHTML = `
          <div class="text-center py-8 text-xs text-slate-400">
            <span>未找到关于 "<strong class="text-slate-900 dark:text-slate-100">${query}</strong>" 的相关机场或教程</span>
          </div>
        `;
        return;
      }

      resultsContainer.innerHTML = matches.map((item) => {
        const reviewHref = resolveHref(item.url);
        const affHref = resolveHref(item.affiliateUrl);

        return `
          <div class="p-3.5 rounded-2xl border ${
            item.isRisk
              ? 'border-rose-500/40 bg-rose-50/50 dark:bg-rose-950/20'
              : 'border-slate-200 dark:border-slate-800 hover:border-indigo-500/50 hover:bg-slate-50 dark:hover:bg-slate-800/50'
          } transition-all flex items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase ${
                  item.type === 'guide'
                    ? 'bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300'
                    : item.type === 'tool'
                    ? 'bg-sky-100 text-sky-800 dark:bg-sky-500/20 dark:text-sky-300'
                    : 'bg-indigo-100 text-indigo-800 dark:bg-indigo-500/20 dark:text-indigo-300'
                }">${item.typeLabel || '机场'}</span>
                <span class="font-bold text-sm text-slate-900 dark:text-white">${item.title}</span>
                ${
                  item.isRisk
                    ? '<span class="px-2 py-0.5 rounded text-[10px] font-black bg-rose-500 text-white">⚠️ 跑路风险</span>'
                    : ''
                }
                <span class="text-xs text-slate-400 font-sans font-bold">${item.price}</span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-1">${item.desc}</p>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <a href="${reviewHref}" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                ${item.type === 'airport' ? '详细评测' : '查看教程'}
              </a>
              ${
                item.type === 'airport'
                  ? `<a href="${affHref}" target="_blank" rel="nofollow sponsored noopener" class="px-3 py-1.5 rounded-xl text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-500 transition-colors">直达官网</a>`
                  : ''
              }
            </div>
          </div>
        `;
      }).join('');
    }

    input?.addEventListener('input', (e) => {
      renderResults(e.target.value);
    });
  }

  initSearchModal();
  document.addEventListener('astro:page-load', initSearchModal);
</script>
