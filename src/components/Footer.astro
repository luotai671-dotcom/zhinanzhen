---
import { SITE_CONFIG } from '../consts';
import {
  Compass,
  Flame,
  ShieldAlert,
  Sparkles,
  BookOpen,
  Download,
  Gift,
  ShieldCheck,
  Send,
  Rss,
  FileText,
  Activity,
  Layers,
  Zap,
  ArrowRight,
  ExternalLink,
  CheckCircle2,
} from 'lucide-astro';

// 11 家主力专线机场快速直达列表
const airportPillList = [
  { name: '闪电鼠 (主推)', slug: 'shandianshu', highlight: true },
  { name: '大佬云', slug: 'dalaoyun' },
  { name: '榴莲云', slug: 'liulianyun' },
  { name: '神行加速', slug: 'shenxing' },
  { name: '云界线', slug: 'yunjiexian' },
  { name: '环球梯', slug: 'huanqiuti' },
  { name: '极连云', slug: 'jilianyun' },
  { name: '光速云', slug: 'guangshuyun' },
  { name: '光年梯', slug: 'guangnianti' },
  { name: '边缘节点', slug: 'edgenova' },
  { name: '速界', slug: 'sujie' },
];
---

<footer class="mt-20 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-surface-950 text-slate-600 dark:text-slate-400 text-sm transition-colors">
  
  <!-- 顶层核心优势展示栏 (Top Trust Highlights) -->
  <div class="border-b border-slate-100 dark:border-slate-800/80 bg-slate-50/70 dark:bg-surface-900/40 py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-xs">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0">
            <Zap class="w-4 h-4" />
          </div>
          <div>
            <span class="font-bold text-slate-900 dark:text-white block">晚高峰千兆压测</span>
            <span class="text-[11px] text-slate-500">每日 21:00 三网实测</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
            <ShieldAlert class="w-4 h-4" />
          </div>
          <div>
            <span class="font-bold text-slate-900 dark:text-white block">7×24H 跑路预警</span>
            <span class="text-[11px] text-slate-500">全球探针监控存活率</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-purple-50 dark:bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
            <Layers class="w-4 h-4" />
          </div>
          <div>
            <span class="font-bold text-slate-900 dark:text-white block">原生住宅双 ISP</span>
            <span class="text-[11px] text-slate-500">ChatGPT/Claude防封</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
            <Gift class="w-4 h-4" />
          </div>
          <div>
            <span class="font-bold text-slate-900 dark:text-white block">月付平价避险</span>
            <span class="text-[11px] text-slate-500">月付 ¥7起 拒绝年付盘</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5 col-span-2 md:col-span-1">
          <div class="w-8 h-8 rounded-xl bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
            <Sparkles class="w-4 h-4" />
          </div>
          <div>
            <span class="font-bold text-slate-900 dark:text-white block">独家优惠券中心</span>
            <span class="text-[11px] text-slate-500">全网 11 家立减折扣</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 主要链接与信息区域 (Main 4-Column Grid) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10">
      
      <!-- Column 1: 品牌使命与探针状态 (4 Cols on lg) -->
      <div class="lg:col-span-4 space-y-4">
        <!-- Logo -->
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 p-[2px] shadow-sm">
            <div class="w-full h-full bg-white dark:bg-surface-950 rounded-[10px] flex items-center justify-center">
              <Compass class="w-4 h-4 text-indigo-600 dark:text-sky-400" />
            </div>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span class="text-lg font-black tracking-tight text-slate-900 dark:text-white">
              {SITE_CONFIG.name}
            </span>
            <span class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500">
              2026
            </span>
          </div>
        </div>

        <!-- Slogan -->
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed pr-2">
          专注全球跨境网络加速、IEPL / IPLC 端到端物理内网专线实测与网络安全。坚持 100% 自费匿名订阅评测，拒绝商业虚标。
        </p>

        <!-- Live Network Status Pill -->
        <div class="p-3 rounded-2xl bg-slate-50 dark:bg-surface-900 border border-slate-200/80 dark:border-slate-800 text-[11px] space-y-1">
          <div class="flex items-center justify-between text-slate-700 dark:text-slate-300 font-semibold">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              探针集群实时在线
            </span>
            <span class="text-slate-400 font-normal">120+ 节点</span>
          </div>
          <div class="text-[10px] text-slate-500 dark:text-slate-400">
            电信 28ms (948M) • 联通 32ms • 移动 25ms
          </div>
        </div>

        <!-- Social & Direct Action Icons -->
        <div class="flex items-center gap-2.5 pt-1">
          <a
            href={SITE_CONFIG.social.telegramChannel}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-surface-900 text-slate-700 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors text-xs font-medium"
            title="Telegram 官方交流群 (@shandianjiaoliu)"
          >
            <Send class="w-3.5 h-3.5 text-sky-500" />
            <span>TG 交流群</span>
          </a>

          <a
            href="/rss.xml"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-slate-100 dark:bg-surface-900 text-slate-700 dark:text-slate-300 hover:text-amber-500 dark:hover:text-amber-400 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors text-xs font-medium"
            title="RSS 订阅源"
          >
            <Rss class="w-3.5 h-3.5 text-amber-500" />
            <span>RSS</span>
          </a>

          <a
            href="/warnings"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-rose-50 dark:bg-rose-950/30 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 hover:bg-rose-100 transition-colors text-xs font-medium"
            title="跑路预警"
          >
            <ShieldAlert class="w-3.5 h-3.5 text-rose-500" />
            <span>跑路黑名单</span>
          </a>
        </div>
      </div>

      <!-- Column 2: 核心专线与推荐专区 (3 Cols on lg) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 flex items-center gap-1.5">
          <Flame class="w-3.5 h-3.5 text-amber-500" />
          <span>核心榜单与推荐专区</span>
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/blog/2026-best-vpn-airport-recommendation-rankings" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">🔥 2026 翻墙机场推荐总榜</span>
              <span class="text-[10px] text-amber-500 font-bold">TOP</span>
            </a>
          </li>
          <li>
            <a href="/airports" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">📋 11 家精选专线机场库</span>
              <span class="text-[10px] text-slate-400">实测</span>
            </a>
          </li>
          <li>
            <a href="/rankings/cheap-airports" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">💰 平价月付 ¥7~¥15 专区</span>
              <span class="text-[10px] text-emerald-500 font-bold">平民</span>
            </a>
          </li>
          <li>
            <a href="/blog/high-speed-iepl-dedicated-line-airports" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">⚡ 高速稳定 IEPL/IPLC 专线</span>
              <span class="text-[10px] text-sky-500 font-bold">千兆</span>
            </a>
          </li>
          <li>
            <a href="/blog/native-residential-ip-chatgpt-tiktok-airports" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">🤖 原生住宅 IP / AI 防封</span>
              <span class="text-[10px] text-purple-500 font-bold">双ISP</span>
            </a>
          </li>
          <li>
            <a href="/coupons" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">✨ 核心机场专属优惠券</span>
              <span class="text-[10px] text-amber-500 font-bold">折扣</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: 客户端与知识库 (3 Cols on lg) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 flex items-center gap-1.5">
          <BookOpen class="w-3.5 h-3.5 text-indigo-500" />
          <span>客户端与新手知识库</span>
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/clients" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">📥 全平台客户端官方下载</span>
              <span class="text-[10px] text-sky-500 font-bold">四端</span>
            </a>
          </li>
          <li>
            <a href="/blog/beginner-setup-anti-runaway-complete-guide" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">🔰 科学上网新手入门全攻略</span>
              <span class="text-[10px] text-rose-500 font-bold">必读</span>
            </a>
          </li>
          <li>
            <a href="/blog/clash-verge-rev-tutorial" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">🚀 Clash Verge Rev 终极教程</span>
              <span class="text-[10px] text-slate-400">TUN</span>
            </a>
          </li>
          <li>
            <a href="/blog/shadowrocket-ios-tutorial" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">📱 Shadowrocket 小火箭配置</span>
              <span class="text-[10px] text-slate-400">iOS</span>
            </a>
          </li>
          <li>
            <a href="/wiki" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">📖 知识百科与协议深度解析</span>
              <span class="text-[10px] text-purple-500 font-bold">百科</span>
            </a>
          </li>
          <li>
            <a href="/llms.txt" class="hover:text-indigo-600 dark:hover:text-white transition-colors flex items-center justify-between group">
              <span class="group-hover:translate-x-0.5 transition-transform">🤖 llms.txt (AI 友好数据)</span>
              <span class="text-[10px] text-slate-400">LLMs</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: 风险防范与评测准则 (2 Cols on lg) -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 flex items-center gap-1.5">
          <ShieldCheck class="w-3.5 h-3.5 text-emerald-500" />
          <span>权威评测 (EEAT)</span>
        </h4>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
          全网首家坚持自费匿名压测。杜绝商业充值操纵榜单，倡导月付避险。
        </p>

        <!-- Trust Badges -->
        <div class="space-y-1.5 pt-1">
          <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20 w-full">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>晚高峰真实千兆实测</span>
          </div>
          <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-medium bg-sky-50 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-500/20 w-full">
            <span class="text-sky-500 font-bold">✓</span>
            <span>原生住宅双 ISP 验证</span>
          </div>
          <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-medium bg-rose-50 dark:bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-500/20 w-full">
            <span class="text-rose-500 font-bold">✓</span>
            <span>跑路停运黑名单通报</span>
          </div>
        </div>
      </div>

    </div>

    <!-- 11 家主力专线机场快速评测导航 (Airport Brand Quick Links) -->
    <div class="mt-10 pt-6 border-t border-slate-100 dark:border-slate-800/80">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 shrink-0 flex items-center gap-1">
          <Activity class="w-3.5 h-3.5 text-indigo-500" />
          <span>主力专线深度评测：</span>
        </span>
        <div class="flex flex-wrap items-center gap-2 text-xs">
          {airportPillList.map((item) => (
            <a
              href={`/airports/${item.slug}`}
              class={`px-2.5 py-1 rounded-xl transition-all text-[11px] ${
                item.highlight
                  ? 'bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-300 dark:border-amber-500/30 font-bold hover:bg-amber-100'
                  : 'bg-slate-100 dark:bg-surface-900 text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-800'
              }`}
            >
              {item.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Affiliate Disclosure Banner (Mandatory for Google SEO EEAT) -->
    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800/80">
      <div class="rounded-2xl bg-slate-50 dark:bg-surface-900/60 border border-slate-200/80 dark:border-slate-800 p-4">
        <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
          <strong class="text-slate-800 dark:text-slate-300">推广佣金透明度说明（Affiliate Disclosure）：</strong>
          {SITE_CONFIG.disclosure}
        </p>
      </div>
    </div>

    <!-- Copyright & Disclaimer -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <div>
        © {new Date().getFullYear()} {SITE_CONFIG.name} ({SITE_CONFIG.englishName}). 保留所有权利。
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 text-[11px]">
        <a href="/" class="hover:text-slate-600 dark:hover:text-slate-300">首页</a>
        <span>•</span>
        <a href="/airports" class="hover:text-slate-600 dark:hover:text-slate-300">机场推荐</a>
        <span>•</span>
        <a href="/rankings/cheap-airports" class="hover:text-slate-600 dark:hover:text-slate-300">平价专区</a>
        <span>•</span>
        <a href="/clients" class="hover:text-slate-600 dark:hover:text-slate-300">客户端</a>
        <span>•</span>
        <a href="/coupons" class="hover:text-slate-600 dark:hover:text-slate-300">福利中心</a>
        <span>•</span>
        <a href="/blog" class="hover:text-slate-600 dark:hover:text-slate-300">博客</a>
        <span>•</span>
        <a href="/warnings" class="hover:text-slate-600 dark:hover:text-slate-300">跑路预警</a>
        <span>•</span>
        <a href="/wiki" class="hover:text-slate-600 dark:hover:text-slate-300">百科</a>
        <span>•</span>
        <a href="/sitemap-index.xml" class="hover:text-slate-600 dark:hover:text-slate-300">网站地图</a>
        <span>•</span>
        <a href="/rss.xml" class="hover:text-slate-600 dark:hover:text-slate-300">RSS</a>
        <span>•</span>
        <a href="/llms.txt" class="hover:text-slate-600 dark:hover:text-slate-300">LLMs Data</a>
      </div>
    </div>

  </div>
</footer>
