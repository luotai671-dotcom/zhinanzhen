---
import {
  Zap,
  ShieldCheck,
  Activity,
  ArrowRight,
  ExternalLink,
  Flame,
  CheckCircle2,
  Lock,
  Wifi,
  Sparkles,
} from 'lucide-astro';
---

<!-- Top Live Network Status Ticker -->
<div class="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-surface-900 py-2 px-4 text-xs">
  <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2 text-slate-600 dark:text-slate-300">
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar whitespace-nowrap">
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400 font-bold text-[11px] border border-emerald-200 dark:border-emerald-500/30">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        探针实时在线
      </span>
      <span class="text-slate-300 dark:text-slate-700">|</span>
      <span>电信晚高峰: <strong class="text-slate-900 dark:text-white font-mono font-bold">28ms</strong> (948Mbps)</span>
      <span class="text-slate-300 dark:text-slate-700">•</span>
      <span>联通9929: <strong class="text-slate-900 dark:text-white font-mono font-bold">32ms</strong> (912Mbps)</span>
      <span class="text-slate-300 dark:text-slate-700">•</span>
      <span>移动CMI: <strong class="text-slate-900 dark:text-white font-mono font-bold">25ms</strong> (980Mbps)</span>
      <span class="text-slate-300 dark:text-slate-700">•</span>
      <span class="text-slate-500">监测节点: 120+ 处</span>
    </div>

    <div class="hidden sm:flex items-center gap-3 text-[11px] text-slate-500 dark:text-slate-400">
      <span class="flex items-center gap-1 font-medium">
        <ShieldCheck class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-500" />
        自费匿名订阅 · 拒绝商业虚标
      </span>
      <span>•</span>
      <span>更新于: 今日 21:00 晚高峰实测</span>
    </div>
  </div>
</div>

<section class="relative pt-8 pb-12 lg:pt-12 lg:pb-16 overflow-hidden bg-white dark:bg-surface-950 border-b border-slate-200/80 dark:border-slate-800">
  <!-- Clean Subtle Network Grid Background (Daytime Crisp) -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#f1f5f9_1px,transparent_1px),linear-gradient(to_bottom,#f1f5f9_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#1e293b50_1px,transparent_1px),linear-gradient(to_bottom,#1e293b50_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- 2-Column Split Hero Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      
      <!-- Left Column: Copy & High-Converting Value Proposition -->
      <div class="lg:col-span-7 space-y-5">
        
        <!-- Geek Tag Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-xs font-mono font-semibold">
          <Activity class="w-3.5 h-3.5 text-indigo-600 dark:text-sky-400" />
          <span>2026 跨境网络与物理专线真实测速数据库</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-slate-900 dark:text-white tracking-tight leading-[1.18]">
          2026 全网优质机场实测与避坑指南<br />
          <span class="text-indigo-600 dark:text-sky-400 text-2xl sm:text-3xl lg:text-3xl font-extrabold block mt-2">
            三网千兆晚高峰压测 · 原生解锁检测 · 拒绝断流跑路
          </span>
        </h1>

        <!-- High Information Density Description -->
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
          我们部署了广州/上海/北京三网千兆真机自动化探针，持续监测全网主流科学上网服务商的<strong>晚高峰丢包率、下行吞吐与 ChatGPT 住宅 IP 原生解锁能力</strong>。所有测试均自费匿名订阅，提供客观中立的性能大表与停运跑路风险预警。
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="/go/shandianshu"
            target="_blank"
            rel="nofollow sponsored noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl font-black text-sm text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-500/20 hover:shadow-lg transition-all active:scale-95 cursor-pointer"
          >
            <span>👑 直达综合 No.1 专线 (闪电鼠) 专属立减</span>
            <ArrowRight class="w-4 h-4" />
          </a>

          <a
            href="#airports-section"
            class="inline-flex items-center gap-2 px-5 py-3.5 rounded-2xl font-bold text-sm text-slate-800 dark:text-slate-200 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 transition-all"
          >
            <span>⚡ 查看测速对比总表</span>
          </a>
        </div>

        <!-- 4 Hardcore Trust Pillars (EEAT Credibility) -->
        <div class="pt-3 grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
          <div class="p-3 rounded-2xl bg-slate-50 dark:bg-surface-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] text-slate-400 dark:text-slate-500 block">评测准则</span>
            <span class="font-extrabold text-slate-900 dark:text-white">100% 自费实测</span>
          </div>
          <div class="p-3 rounded-2xl bg-slate-50 dark:bg-surface-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] text-slate-400 dark:text-slate-500 block">压测环境</span>
            <span class="font-extrabold text-emerald-600 dark:text-emerald-400">晚高峰 21:00</span>
          </div>
          <div class="p-3 rounded-2xl bg-slate-50 dark:bg-surface-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] text-slate-400 dark:text-slate-500 block">AI 解锁验证</span>
            <span class="font-extrabold text-sky-600 dark:text-sky-400">住宅原生双 ISP</span>
          </div>
          <div class="p-3 rounded-2xl bg-slate-50 dark:bg-surface-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] text-slate-400 dark:text-slate-500 block">跑路监测</span>
            <span class="font-extrabold text-rose-600 dark:text-rose-400">7×24H 探针报警</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Live Benchmark Monitor Card (硬核测速监控台) -->
      <div class="lg:col-span-5">
        <div class="relative rounded-3xl p-6 bg-white dark:bg-surface-900 border border-slate-200 dark:border-slate-800 shadow-xl overflow-hidden">
          
          <!-- Card Header: Target Airport Spotlight -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-amber-500 text-white">
                  TOP 1 监控标杆
                </span>
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400">闪电鼠 (IEPL 01)</span>
              </div>
              <h3 class="text-lg font-black text-slate-900 dark:text-white mt-1">
                深圳-香港 · IEPL 纯内网物理专线
              </h3>
            </div>

            <!-- Ping Radar Pulse -->
            <div class="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
              <Wifi class="w-4 h-4 animate-pulse" />
            </div>
          </div>

          <!-- Core Realtime Benchmarks Visualizer -->
          <div class="grid grid-cols-3 gap-2.5 my-4">
            <div class="p-3 rounded-2xl bg-slate-50 dark:bg-surface-950 border border-slate-200/80 dark:border-slate-800 text-center">
              <span class="text-[10px] text-slate-400 dark:text-slate-500 block">下行峰值带宽</span>
              <span class="text-xl font-black text-sky-600 dark:text-sky-400 font-sans font-bold tabular-nums">1,980</span>
              <span class="text-[10px] text-slate-400 dark:text-slate-500 block">Mbps</span>
            </div>
            <div class="p-3 rounded-2xl bg-slate-50 dark:bg-surface-950 border border-slate-200/80 dark:border-slate-800 text-center">
              <span class="text-[10px] text-slate-400 dark:text-slate-500 block">平均往返时延</span>
              <span class="text-xl font-black text-emerald-600 dark:text-emerald-400 font-sans font-bold tabular-nums">21</span>
              <span class="text-[10px] text-slate-400 dark:text-slate-500 block">ms (±0.8ms)</span>
            </div>
            <div class="p-3 rounded-2xl bg-slate-50 dark:bg-surface-950 border border-slate-200/80 dark:border-slate-800 text-center">
              <span class="text-[10px] text-slate-400 dark:text-slate-500 block">晚高峰丢包率</span>
              <span class="text-xl font-black text-indigo-600 dark:text-indigo-400 font-sans font-bold tabular-nums">0.00%</span>
              <span class="text-[10px] text-slate-400 dark:text-slate-500 block">零断流</span>
            </div>
          </div>

          <!-- YouTube 8K Stream Buffer Gauge -->
          <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-surface-950 border border-slate-200/80 dark:border-slate-800 my-3.5">
            <div class="flex items-center justify-between text-xs mb-1.5">
              <span class="font-bold text-slate-700 dark:text-slate-300">YouTube 8K 实时吞吐吞吐率</span>
              <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">238,500 Kbps (秒开)</span>
            </div>
            <div class="w-full bg-slate-200 dark:bg-slate-800 h-2 rounded-full overflow-hidden">
              <div class="bg-gradient-to-r from-emerald-500 to-sky-500 h-full rounded-full" style="width: 98%"></div>
            </div>
          </div>

          <!-- Unlocking Status Matrix Checklist -->
          <div class="space-y-2 text-xs py-1">
            <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60">
              <span class="text-slate-500 dark:text-slate-400">OpenAI ChatGPT / Claude 3.5:</span>
              <span class="font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                <CheckCircle2 class="w-3.5 h-3.5" /> 双ISP原生住宅 100%全绿
              </span>
            </div>
            <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60">
              <span class="text-slate-500 dark:text-slate-400">Netflix / Disney+ 4K HDR:</span>
              <span class="font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                <CheckCircle2 class="w-3.5 h-3.5" /> 全区非自制剧秒开
              </span>
            </div>
            <div class="flex items-center justify-between py-1">
              <span class="text-slate-500 dark:text-slate-400">起步价格 / 传输协议:</span>
              <span class="font-bold text-slate-800 dark:text-slate-200">月付低至 ¥8 · VLESS现代协议</span>
            </div>
          </div>

          <!-- Card Bottom CTA Action -->
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-3">
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
              <span>专属优惠码: </span>
              <span class="font-mono font-bold text-amber-600 dark:text-amber-400">sd88</span>
            </div>
            <a
              href="/go/shandianshu"
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="inline-flex items-center gap-1 px-4 py-2 rounded-xl text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 transition-colors shadow-sm"
            >
              <span>查看闪电鼠官网</span>
              <ExternalLink class="w-3.5 h-3.5" />
            </a>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

    </div>

  </div>
</section>
