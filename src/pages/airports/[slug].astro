---
import { getCollection } from 'astro:content';
import ReviewLayout from '../../layouts/ReviewLayout.astro';

export async function getStaticPaths() {
  const airports = await getCollection('airports');
  return airports.map((airport) => ({
    params: { slug: airport.slug },
    props: { airport },
  }));
}

const { airport } = Astro.props;
const { Content } = await airport.render();
---

<ReviewLayout airport={airport}>
  <Content />
</ReviewLayout>

