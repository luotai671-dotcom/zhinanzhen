---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirportCard from '../../components/AirportCard.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../../consts';

const airports = await getCollection('airports');
const ieplAirports = airports
  .filter((a) => a.data.linesType.includes('IEPL') || a.data.category.includes('iepl'))
  .sort((a, b) => a.data.rank - b.data.rank);

const breadcrumbItems = [
  { name: '专线机场推荐', href: '/rankings/iepl-airports' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '2026顶级IEPL内网专线机场推荐榜',
  description: '精选完全不经过GFW公网防火墙的顶级IEPL/IPLC内网专线机场，晚高峰千兆带宽不降速。',
  itemListElement: ieplAirports.map((airport, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${SITE_CONFIG.siteUrl}/airports/${airport.slug}`,
    name: airport.data.name,
  })),
};
---

<BaseLayout
  title={`2026顶级IEPL内网专线机场推荐与晚高峰测速榜 - ${SITE_CONFIG.name}`}
  description="专线机场哪家好？汇总2026全网优质IEPL/IPLC纯内网专线机场。数据完全不经过公网GFW防火墙，晚高峰4K/8K秒开，支持ChatGPT原生解锁与专属优惠码。"
  schema={itemListSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Topic Hero -->
    <div class="my-8 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-semibold mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>工业级SLA保障 · 零丢包专线</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        2026 顶级 IEPL 纯内网专线机场精选榜
      </h1>
      <p class="mt-4 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        所谓“真专线”，是指在深圳-香港、上海-日本等物理跨境节点之间铺设的端到端点对点内网光纤，数据完全不经过 GFW 公网拦截。无论是敏感时期还是晚高峰 21:00，均能保持 0.05% 以下的极限超低丢包率。
      </p>
    </div>

    <!-- Comparison Table -->
    <ComparisonTable airports={ieplAirports} />

    <!-- Cards List -->
    <div class="my-12">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-6">
        专线机场深度评测列表（按综合排名）
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {ieplAirports.map((airport) => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
