<script>
  // 侧边栏 ScrollSpy (滚动高亮与定位)
  function initWikiScrollSpy() {
    const sections = document.querySelectorAll('section[id], div[id^="proto-"], div[id^="faq-"]');
    const tocLinks = document.querySelectorAll('.toc-link');
    const backToTopBtn = document.getElementById('back-to-top-btn');

    // 返回顶部平滑滚动
    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // 滚动高亮监听
    function onScroll() {
      const scrollPos = window.scrollY + 130;
      let currentSectionId = '';

      sections.forEach((sec) => {
        const el = sec as HTMLElement;
        const top = el.offsetTop;
        const height = el.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          currentSectionId = el.getAttribute('id') || '';
        }
      });

      if (currentSectionId) {
        tocLinks.forEach((link) => {
          const href = link.getAttribute('href');
          if (href === '#' + currentSectionId) {
            link.classList.add('text-indigo-600', 'dark:text-sky-400', 'font-black', 'bg-indigo-50/80', 'dark:bg-indigo-950/50');
            link.classList.remove('text-slate-500', 'dark:text-slate-400', 'text-slate-700', 'dark:text-slate-300');
          } else {
            link.classList.remove('text-indigo-600', 'dark:text-sky-400', 'font-black', 'bg-indigo-50/80', 'dark:bg-indigo-950/50');
          }
        });
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  initWikiScrollSpy();
  document.addEventListener('astro:page-load', initWikiScrollSpy);
</script>
