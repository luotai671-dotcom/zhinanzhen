<script>
  function setupCategoryFiltering() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
    const cards = document.querySelectorAll<HTMLElement>('.airport-card');

    function filterByCat(catId: string) {
      tabs.forEach((tab) => {
        const isCurrent = tab.getAttribute('data-category') === catId;
        if (isCurrent) {
          tab.classList.remove('bg-slate-100', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
          tab.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');
        } else {
          tab.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
          tab.classList.add('bg-slate-100', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
        }
      });

      cards.forEach((card) => {
        const cats: string[] = JSON.parse(card.getAttribute('data-categories') || '["all"]');
        if (catId === 'all' || cats.includes(catId)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const cat = tab.getAttribute('data-category') || 'all';
        filterByCat(cat);
      });
    });

    // Check trigger from navbar links
    document.querySelectorAll('[data-filter-trigger]').forEach((el) => {
      el.addEventListener('click', (e) => {
        const triggerCat = el.getAttribute('data-filter-trigger');
        if (triggerCat) {
          filterByCat(triggerCat);
        }
      });
    });
  }

  setupCategoryFiltering();
  document.addEventListener('astro:page-load', setupCategoryFiltering);
</script>
